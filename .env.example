APP_NAME=Minerva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Bcrypt cost factor for password hashing.
# - 10 = ~60-80ms per hash (recommended for SLO login < 1s)
# - 12 = ~250-300ms per hash (Laravel default, OWASP recommended for high-security)
# Bumping to 10 gives ~200ms savings per login at the cost of a slightly weaker hash
# (still ~1B iterations to brute-force a single password with modern GPUs).
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Variant A dual-write (sunset 2027-02-06): DB nueva es `minerva`.
# `tecnoinnsoft_crm` queda como rollback target hasta esa fecha.
DB_DATABASE=minerva
DB_USERNAME=root
DB_PASSWORD=

# Read replica connection (CQRS Táctico Phase 2). When DB_READ_HOST is unset
# the read connection falls back to the master (DB_HOST). Point DB_READ_HOST
# to a MariaDB read replica when one is provisioned; reads will route there
# without any code change required.
# DB_READ_HOST=127.0.0.1
# DB_READ_PORT=3306
# DB_READ_DATABASE=minerva
# DB_READ_USERNAME=readonly
# DB_READ_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# CORS — orígenes autorizados a consumir la API desde el navegador.
# Separar múltiples con coma, sin espacios. Sin slash final.
CORS_ALLOWED_ORIGINS=https://crm.tecnoinnsoft.com,https://prod-dashboard-crm.jsvdny.easypanel.host

N8N_PIPELINE_WEBHOOK_URL=https://prod-sailus-getway.jsvdny.easypanel.host/api/v1/webhook/crm-outbound
N8N_PIPELINE_WEBHOOK_SECRET=
